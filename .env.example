# Copia este archivo a .env y rellena lo que tengas.
# El análisis funciona sin ninguna de estas claves: los factores que las
# necesitan simplemente quedan marcados como "no disponible" en el informe.

GOOGLE_PLACES_API_KEY=
NASA_EARTHDATA_TOKEN=

# Identifícate ante Nominatim (política de uso de OSM): incluye una URL o
# contacto real, no un email personal a secas.
NOMINATIM_USER_AGENT=PisoCheck/0.1 (uso personal)

# Cache
CACHE_DIR=.pisocheck_cache
CACHE_TTL_HOURS=72

# Output
OUTPUT_DIR=./informes
